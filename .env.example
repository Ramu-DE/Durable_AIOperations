# Copy to .env and fill in your values after running infra/create_cluster.sh

# ── DSQL endpoints ────────────────────────────────────────────────────────────
DSQL_ENDPOINT_A=<cluster-id>.dsql.us-east-1.on.aws
DSQL_ENDPOINT_B=<cluster-id>.dsql.us-west-2.on.aws

# Backwards-compat aliases used by older scripts
DSQL_ENDPOINT=$DSQL_ENDPOINT_A
DSQL_ENDPOINT_PEER=$DSQL_ENDPOINT_B

# ── AWS / Bedrock ─────────────────────────────────────────────────────────────
REGION_A=us-east-1
REGION_B=us-west-2
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001:0

# ── FastAPI worker ────────────────────────────────────────────────────────────
WORKER_REGION=us-east-1    # set to REGION_B for the second worker process

# ── Chaos injection (leave blank for normal runs) ─────────────────────────────
CRASH_AFTER_STEP=
